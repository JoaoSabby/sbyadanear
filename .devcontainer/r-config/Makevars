# Optional user defaults for the Intel oneAPI container. The package's own
# src/Makevars independently requires icpx and enables Intel OpenMP/oneMKL.
CC = icx
CXX = icpx
CXX11 = icpx
CXX14 = icpx
CXX17 = icpx
CXX20 = icpx
CXX23 = icpx
CFLAGS = -O2 -fp-model=precise
CXXFLAGS = -O2 -fp-model=precise
CXX20FLAGS = -O2 -fp-model=precise
SHLIB_OPENMP_CFLAGS = -qopenmp
SHLIB_OPENMP_CXXFLAGS = -qopenmp
# Fortran dependencies use the R configuration; the package has no Fortran.
MAKEFLAGS = -j2
