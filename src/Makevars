CXX_STD = CXX20
override CXX20 = icpx
override CXX20STD = -std=c++20
override CXX20FLAGS = -O3 -fPIC -fp-model=precise
override SHLIB_CXXLD = icpx
OBJECTS = sby_engine.o
SBY_MKL_ROOT = $(MKLROOT)
ifeq ($(strip $(SBY_MKL_ROOT)),)
$(error Load Intel oneAPI setvars.sh before installing: MKLROOT is required)
endif
SBY_MKL_CORE = $(firstword $(wildcard $(SBY_MKL_ROOT)/lib/intel64/libmkl_core.so $(SBY_MKL_ROOT)/lib/libmkl_core.so))
ifeq ($(strip $(SBY_MKL_CORE)),)
$(error Cannot locate Intel oneMKL libraries under MKLROOT)
endif
SBY_MKL_LIB = $(patsubst %/,%,$(dir $(SBY_MKL_CORE)))
PKG_CPPFLAGS = -I$(SBY_MKL_ROOT)/include
PKG_CXXFLAGS = -qopenmp -fp-model=precise
PKG_LIBS = -qopenmp -L$(SBY_MKL_LIB) -Wl,-rpath,$(SBY_MKL_LIB) -Wl,--no-as-needed -lmkl_intel_lp64 -lmkl_intel_thread -lmkl_core -liomp5 -lpthread -lm -ldl
